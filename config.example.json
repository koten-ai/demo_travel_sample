{
  "build_version": "",
  "_comment": "Travel planner config. Copy to config.json and fill in your keys. Nested zeus/llm_provider/samples stay valid. Zeus 0.7.x is pinned to chat_request base-6.1 — keep client_floor at client-floor-6.1 or AgentAPI.run_turn drops the catalog. session.semantic_cache.enabled needs Zeus >= 0.7.6; leave false unless you opt in. The search UI version stamp is the installed kotenai-zeus-client (2.4.0), not build_version. Hub Analysis Prompt sent tiles need ?debug=true (rewind) + durable_sessions + client >= 2.4.0.",

  "zeus": {
    "url": "http://host.docker.internal:8080",
    "auth_mode": "basic",
    "username": "demo_1",
    "password": "",
    "bearer_token": "",
    "session_id": "",
    "scope_credentials": {
      "travel-sample/inventory": { "username": "demo_1", "password": "" }
    },
    "scope_contracts": {
      "travel-sample/inventory": {
        "analytics": {
          "contract_id": "analytics_base5_2",
          "contract_hash": "md5:5aacbf1d7a4d9d5de9436cdffbce050f"
        }
      }
    },
    "enable_durable_sessions": true
  },

  "llm_provider": {
    "label": "xAI Grok",
    "base_url": "https://api.x.ai/v1",
    "api_key": "",
    "models": [
      "grok-4-1-fast-non-reasoning",
      "grok-4-1-fast-reasoning",
      "grok-4",
      "grok-3-mini"
    ]
  },

  "chat_requests_sync": {
    "scopes": "from_contracts",
    "modes": ["analytics"],
    "on_startup": true
  },

  "client_floor": "client-floor-6.1",
  "profile": "development",
  "settings": {
    "mode": "analytics",
    "ai_process_result": false,
    "durable_sessions": true,
    "max_rounds": 12,
    "ignore_user_tool_path_hints": true
  },
  "session": {
    "semantic_cache": {
      "enabled": false
    }
  },

  "default_api_version": "v2",
  "default_mode": "analytics",
  "default_sample": "travel-sample",
  "samples": {
    "travel-sample": {
      "bucket": "travel-sample",
      "scope": "inventory",
      "collection": "hotel"
    }
  }
}
